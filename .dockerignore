# What the image build must never see or does not need. Patterns without a slash match
# at the top of the build context only, so data files and data folders carry **/ to match
# at any depth, as they do in .gitignore.

# Version control, editor, CI and coding-assistant files (.claude/ holds local settings
# and whole worktrees of the repository)
.git/
.github/
.vscode/
**/.claude/

# Secrets and local settings, at any depth (.env.example is not a secret, but the build
# does not read it)
.env
.env.*
**/.env
**/.env.*

# Installed and built output: the build makes its own
node_modules/
.nuxt/
.output/
forecast/.venv/
**/__pycache__/

# Databases and call data: never part of an image
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/*-cli-run-*.lock
**/data/
**/*.xlsx
**/*.xls
**/*.csv
**/*.csv.gz
**/*.parquet

# Tests, research record, documents and reports: not needed to build or run the app
tests/
forecast/tests/
forecast/tools/
forecast/docs/
docs/
wpr/
