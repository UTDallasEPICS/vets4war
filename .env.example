# Vets4Warriors staffing: environment variables.
#
# Local work: copy this file to .env and edit it. `pnpm dev`, `pnpm build`, `pnpm db:migrate`
# and `pnpm db:seed` read .env. A production build does NOT read .env by itself: give it real
# environment variables, or start it with `pnpm start`, which passes .env to it.
# Never commit .env. Comments go on their own lines: some tools take the whole line as the value.

# --- Required -----------------------------------------------------------------

# The SQLite file that holds everything: people, calls, uploads, runs, the model, the
# forecast. Default: file:./dev.db. A relative path starts at the folder the server
# starts in (the repository root).
DATABASE_URL=file:./dev.db

# Signs the session cookies. Use your own long random text: openssl rand -hex 32
# (at least 32 characters; a production build refuses to start with the value below and
# warns about a shorter one). Changing it later signs everyone out.
BETTER_AUTH_SECRET=replace-this-with-the-output-of-openssl-rand-hex-32

# The address people type in the browser, exactly: scheme, host and port. When the
# browser's address differs from it, people can still sign in and read, but every change
# (an upload, a retrain, adding a person) and signing out are refused.
BETTER_AUTH_URL=http://localhost:3000

# --- Sign-in mail ---------------------------------------------------------------

# How a sign-in code reaches a person.
#   smtp     (default) send it by mail. EMAIL_HOST, EMAIL_USER, EMAIL_PASS and EMAIL_FROM
#            are then required.
#   console  print it in the server log instead. Accepted by `pnpm dev` only: a
#            production build refuses to start with it.
EMAIL_TRANSPORT=console

# The mail server (used only with EMAIL_TRANSPORT=smtp).
# EMAIL_HOST=smtp.example.org
# Default 587.
# EMAIL_PORT=587
# Default false. true = TLS from the first byte (usually port 465).
# EMAIL_SECURE=false
# EMAIL_USER=mailbox-user
# EMAIL_PASS=mailbox-password
# The sender address people see.
# EMAIL_FROM=staffing@example.org

# --- People and labels -----------------------------------------------------------

# Comma-separated addresses that are made admins on every server start and by
# `pnpm db:seed`: created when missing, promoted when a viewer. Nobody is ever demoted or
# removed by it. Default: empty (nobody is added, so nobody can sign in to a new database).
V4W_ADMIN_EMAILS=admin@example.org

# What the badge on the console says the data is: partner or synthetic. Anything else, or
# unset, shows "Data source not set (V4W_DATA_SOURCE)". Say what the data really is.
V4W_DATA_SOURCE=synthetic

# --- Retraining (defaults shown; remove the # to change one) -----------------------

# Folder of the Python project. Default: forecast under the folder the server starts in.
# V4W_FORECAST_DIR=./forecast
# The Python that runs the retrain script. Default: <V4W_FORECAST_DIR>/.venv/bin/python
# when that file exists (`pnpm forecast:setup` makes it), else python3 from PATH.
# V4W_PYTHON=./forecast/.venv/bin/python
# The Python module the server starts with -m. Tests point it at a stand-in; leave it alone.
# V4W_RETRAIN_MODULE=db.retrain
# true: an import of call data starts a retrain. false: it waits for the scheduled check
# or for an admin to start one.
# V4W_RETRAIN_ON_IMPORT=true
# on: the scheduled check may start a retrain or a forecast refresh. off: it does nothing.
# V4W_RETRAIN_SCHEDULE=on
# When the scheduled check runs: a cron line in the server's local time (UTC in the
# image). Read when the app is BUILT (`pnpm build`), not when it starts.
# V4W_RETRAIN_CRON="30 8 * * *"
# A run still going after this many minutes is stopped and marked failed.
# V4W_RETRAIN_TIMEOUT_MIN=60

# Read by the Python script (the server passes its own environment on to it):
# Worker processes of the accuracy check. Default: 4, or the number of CPUs when fewer.
# V4W_GATE_WORKERS=4
# The forecast is written through max(today, the last call day) plus this many days.
# V4W_HORIZON_DAYS=800
# Last year of official holidays kept in the holidays table. Default: the year after the
# one the forecast ends in.
# V4W_HOLIDAYS_THROUGH_YEAR=2030

# --- Uploads (defaults shown) ------------------------------------------------------

# Largest call-records file accepted, in MB.
# V4W_UPLOAD_MAX_MB=40
# Most calls one file may hold.
# V4W_UPLOAD_MAX_ROWS=750000

# --- Where the server listens ------------------------------------------------------

# The port. Default 3000. Read by `pnpm dev` and by a production build; `pnpm dev --port
# 3001` sets it for one run. BETTER_AUTH_URL must name the same port.
# PORT=3000
# The interface a production build listens on. Default: all interfaces.
# HOST=0.0.0.0

# --- One-time and development tools ------------------------------------------------

# The connection string of the OLD Postgres database. Read only by
# scripts/copy-from-postgres.ts (the one-time copy of the call history) and by the
# comparison tool scripts/parity/legacy_export.py. It carries a password.
# V4W_DATABASE_URL=postgres://user:password@db.example.org:5432/postgres

# `pnpm dev` only: send /api/forecast, /api/staffing, /api/planned and /api/model to
# another server that answers in the same shapes. Leave it unset.
# V4W_DEV_API_PROXY=http://localhost:9000
