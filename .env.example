# SQLite file. Relative paths resolve against the folder the server is started in.
DATABASE_URL=file:./dev.db

# Better Auth. BETTER_AUTH_URL must be the address people type in the browser.
BETTER_AUTH_SECRET="randomly-generated-str"
BETTER_AUTH_URL=http://localhost:3000

# Sign-in codes: smtp sends mail; console prints the code in the server log and is
# accepted only by `pnpm dev` (a production build refuses to start with it).
EMAIL_TRANSPORT=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="sample-user@gmail.com"
EMAIL_PASS="google-app-pwd"
EMAIL_FROM="sample-user@gmail.com"

# Comma-separated addresses made admins on every start (never demotes anyone).
V4W_ADMIN_EMAILS=admin@example.org

# What the badge says the data is: partner or synthetic. Unset = "not set". Never guess.
V4W_DATA_SOURCE=synthetic

# Python retrain script (defaults shown).
# V4W_FORECAST_DIR=./forecast
# V4W_PYTHON=./forecast/.venv/bin/python
# V4W_RETRAIN_ON_IMPORT=true
# V4W_RETRAIN_SCHEDULE=on
# V4W_RETRAIN_CRON="30 8 * * *"     # read when the app is BUILT
# V4W_RETRAIN_TIMEOUT_MIN=60
# V4W_GATE_WORKERS=4
# V4W_HORIZON_DAYS=800

# Upload limits (defaults shown).
# V4W_UPLOAD_MAX_MB=40
# V4W_UPLOAD_MAX_ROWS=750000
