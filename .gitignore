# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

/prisma/generated
/dev.db

# --- Vets4Warriors forecast (Python) ---
# Secrets: the database URL carries the password. .env is already ignored above.
# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
# Call data must never be committed: no exports, no extracts, no caller info.
data/
*.csv
*.csv.gz
*.xlsx
*.xls
*.parquet
# Local agent tooling
.agents/
skills-lock.json
.vercel

# SQLite files and their journals (the database is never committed)
*.db
*.db-journal
*.db-wal
*.db-shm
# The lock a retrain started from a shell holds next to the database while it runs
# (<database file>-cli-run-<run id>.lock); one is left behind when such a run is
# killed while no server is up to clear it.
*-cli-run-*.lock
# Python environment and local outputs of the forecast tree
forecast/.venv/
forecast/forecasts/
# Written by @nuxt/test-utils on every run, so it is not kept in the repository
.nuxtrc
