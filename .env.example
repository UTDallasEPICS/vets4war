# Copy to .env (gitignored) and fill in the real value. Never commit .env.
#
# Supabase project ztvpfsoxreppibvzqefy: Connect button, "Session pooler" tab.
# Percent-encode special characters in the password.
V4W_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# What the dashboard badge says the data is: "partner" or "synthetic".
# Unset = the badge says the source is not labeled. Never guess.
V4W_DATA_SOURCE=partner

# Shared sign-in. Admin and dashboard pages require sign-in by default.
# Select an OIDC provider that supplies a verified email claim, register
# https://YOUR-HOST/auth/callback, and allowlist authorized people below.
V4W_PUBLIC_URL=https://YOUR-HOST
V4W_OIDC_METADATA_URL=
V4W_OIDC_CLIENT_ID=
V4W_OIDC_CLIENT_SECRET=
V4W_SESSION_SECRET=
V4W_ADMIN_EMAILS=
V4W_VIEWER_EMAILS=
V4W_REQUIRE_AUTH=true
V4W_COOKIE_SECURE=true

# Enable after applying the explicit pipeline migration. Store the confirmed
# export contract outside Git (for example data/export-contract.json).
V4W_PIPELINE_ENABLED=false
V4W_EXPORT_CONTRACT=
# API and worker must share this persistent, writable model directory.
V4W_MODEL_DIR=./models
