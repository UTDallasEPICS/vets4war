# Copy to .env (gitignored) and fill in the real value. Never commit .env.
#
# Supabase project (ask the team for its name): Connect button, "Session pooler" tab.
# Percent-encode special characters in the password.
V4W_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# What the dashboard badge says the data is: "partner" or "synthetic".
# Unset = the badge says the source is not labeled. Never guess.
V4W_DATA_SOURCE=partner

# Sign-in (api/site_auth.py). One shared password, no usernames.
# On your own machine, switch the gate off (this line is ignored on Vercel):
V4W_AUTH_DISABLED=1
# On a server, leave V4W_AUTH_DISABLED unset and set both of these instead.
# Without them every request is refused (503), never left open.
#   python -m api.site_auth hash      -> V4W_APP_PASSWORD_HASH (the password is never stored)
#   python -m api.site_auth secret    -> V4W_SESSION_SECRET (changing it signs everyone out)
# V4W_APP_PASSWORD_HASH=
# V4W_SESSION_SECRET=

# Admin imports write to the shared `calls` table. They stay off unless this is 1;
# validating files and reading upload history work either way.
# V4W_ADMIN_IMPORTS=1

# Auth0 API access tokens; domain is a hostname without scheme or trailing slash.
# Ask the teammate who owns the Auth0 tenant for the real values.
AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
AUTH0_AUDIENCE=https://YOUR-API-IDENTIFIER
# Client ID of the Auth0 single-page application the admin page signs in with.
# Not a secret; the page fetches all three from GET /api/admin/config.
AUTH0_CLIENT_ID=YOUR-SPA-CLIENT-ID
# Enable RBAC and Add Permissions in the Access Token in the Auth0 API.
# read:admin: identity and upload history; also required for staging/import.
# import:calls: stage and import workbooks, including explicit replacements.
# trigger:retraining is reserved; no retraining endpoint exists.
