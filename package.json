{
  "name": "vets4war",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node --env-file=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxi typecheck",
    "typecheck:tests": "vue-tsc --noEmit -p tests/tsconfig.app.json && vue-tsc --noEmit -p tests/tsconfig.server.json && vue-tsc --noEmit -p tests/tsconfig.node.json",
    "test": "vitest run --project unit --project nuxt",
    "test:watch": "vitest --project unit --project nuxt",
    "test:parity": "vitest run --project parity",
    "e2e": "node scripts/e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/db/seed.ts",
    "db:push": "drizzle-kit push",
    "forecast:setup": "bash scripts/forecast-setup.sh",
    "forecast:test": "cd forecast && .venv/bin/python -m pytest tests -q"
  },
  "dependencies": {
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/lucide": "1.2.156",
    "@nuxt/ui": "^4.11.0",
    "@types/nodemailer": "^8.0.1",
    "better-auth": "1.7.26",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "h3": "1.15.11",
    "nodemailer": "^9.0.5",
    "nuxt": "^4.5.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/smtp-server": "3.5.13",
    "@vue/test-utils": "^2.4.11",
    "better-sqlite3": "12.11.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "postgres": "4.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "smtp-server": "3.21.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
